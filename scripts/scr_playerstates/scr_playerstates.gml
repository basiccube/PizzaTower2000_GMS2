function scr_playerstates() {
	switch state
	{
	    case 85:
	        scr_player_charge()
	        break
	    case 9:
	        scr_player_knightpepslopes()
	        break
	    case 14:
	        scr_player_gottreasure()
	        break
	    case 15:
	        scr_player_knightpep()
	        break
	    case 16:
	        scr_player_knightpepattack()
	        break
	    case 18:
	        scr_player_bombpep()
	        break
	    case 29:
	        scr_player_tumble()
	        break
	    case 34:
	        scr_player_superslam()
	        break
	    case 48:
	        scr_player_tackle()
	        break
	    case 55:
	        scr_player_victory()
	        break
	    case 81:
	        scr_player_mach3()
	        break
	    case 63:
	        scr_player_bump()
	        break
	}
}